# Copy to .env (git-ignored) and set a password. Read by docker compose and by the application.
JOBS_DB_USER=jobs
JOBS_DB_PASSWORD=
# HTTP port of the application (default 8090)
# JOBS_PORT=8090

# AES-256 key for personal data at rest (base64 of 32 random bytes): openssl rand -base64 32
# Back it up: without it, encrypted candidate data cannot be read.
JOBS_ENCRYPTION_KEY=

# Optional: Anthropic API key. When set, reading a resume offers "Use Claude" (the text is sent to Anthropic with
# e-mail, phone, links and name masked). Leave empty to keep everything on this machine.
# ANTHROPIC_API_KEY=
